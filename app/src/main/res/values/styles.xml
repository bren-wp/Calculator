<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Calculator" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:statusBarColor">@color/brand_background</item>
    <item name="android:navigationBarColor">@color/brand_background</item>
    <item name="android:windowBackground">@color/brand_background</item>
  </style>
  <style name="Theme.Calculator.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/brand_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
    <item name="postSplashScreenTheme">@style/Theme.Calculator</item>
  </style>
</resources>
